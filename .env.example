# Aldridge Auto's Service & Repair — Render / Local Environment Variables
# Copy to .env for local runs, or paste into Render Dashboard -> Environment.

PORT=8080
NODE_ENV=production
CANONICAL_DOMAIN=https://aldridgeautosupply.com
PUBLIC_PWA_URL=https://aldridgeautosupply.com

# Shopify Admin API (aldridgesales.myshopify.com)
# Generate Admin API token in Shopify Admin -> Settings -> Apps and sales channels -> Develop apps
# Required scopes: read_products, write_products, read_inventory, write_inventory, read_orders
SHOPIFY_SHOP_DOMAIN=aldridgesales.myshopify.com
SHOPIFY_DOMAIN=aldridgesales.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_YOUR_SHOPIFY_ADMIN_API_TOKEN_HERE

# Google Gemini Vision API (AI Part Identification on Camera Snap Intake)
# Generate at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaYOUR_GEMINI_API_KEY_HERE
